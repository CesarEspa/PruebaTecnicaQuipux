# Copia este archivo a ".env" y ajusta los valores si lo necesitas.
# docker-compose.yml lee estas variables automaticamente.

# ---- MongoDB ----
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=earthquakes_db

# ---- RabbitMQ ----
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ---- USGS API ----
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
INGESTION_INTERVAL_SECONDS=180

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Cache ----
CACHE_TTL_SECONDS=30

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

